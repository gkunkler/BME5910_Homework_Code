%[text] # Homework 5
%[text] ## BME 5910 - Biomedical Optics
%[text] Garrett Kunkler
%[text] 10/5/2026
%[text] ### Problem 3
% Givens
x_vec = linspace(-2,2,1000); % Define mesh spacing
[x,y] = meshgrid(x_vec); % Create square mesh
r = sqrt(x.*x + y.*y);
S_0 = 5;
FWHM_beam = 1;
R = FWHM_beam * sqrt(1/log(4)) %[output:725c3bc2]
S = S_0 * exp(-2*(r/R).^2);

% Assume same Green's function (but normalized to integrate to 1)
G = 1/pi/R^2 * exp(-2*(r/R).^2);
C = conv2(S,G, "same")*(x_vec(2)-x_vec(1))*(x_vec(2)-x_vec(1)) %[output:11eaad42]

FWHM_S = get_FWHM(S,x_vec) %[output:2675e0af]
FWHM_C = get_FWHM(C,x_vec) %[output:305167b2]

% Calculate FWHM
function fwhm = get_FWHM(f, x)

    [f_max_x,~] = max(f);
    [f_max,~] = max(f_max_x);

    i_low = find(f_max_x > 0.5 * f_max,1,'first');
    i_high = find(f_max_x > 0.5 * f_max,1,'last');

    fwhm = x(i_high) - x(i_low);

end

% Plot Original Gaussian S(r)
mesh(x,y,S) %[output:1929c52c]
hold on; %[output:1929c52c]
phi = linspace(0,2*pi, 100);
plot3(FWHM_S/1.95*cos(phi), FWHM_S/1.95*sin(phi), ones(1,100)*max(S,[], 'all')/2, 'r-') %[output:1929c52c]
hold off; %[output:1929c52c]
xlabel('x') %[output:1929c52c]
ylabel('y') %[output:1929c52c]
zlabel('S(r)') %[output:1929c52c]
title(gca, sprintf('Gaussian Beam (FWHM = %.1f)',FWHM_S)) %[output:1929c52c]

% Plot Original Gaussian S(r)
mesh(x,y,C) %[output:3b28b617]
hold on; %[output:3b28b617]
plot3(FWHM_C/1.95*cos(phi), FWHM_C/1.95*sin(phi), ones(1,100)*max(C,[], 'all')/2, 'r-') %[output:3b28b617]
hold off; %[output:3b28b617]
xlabel('x') %[output:3b28b617]
ylabel('y') %[output:3b28b617]
zlabel('C(r)') %[output:3b28b617]
title(gca, sprintf('Convolution Result (FWHM = %.1f)',FWHM_C)) %[output:3b28b617]

