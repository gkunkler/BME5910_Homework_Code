%[text] # Homework 8
%[text] Author: Garrett Kunkler
%[text] Created: 11/9/2026
%[text] Edited: 11/9/2026
%%
%[text] ### Part 1
%[text] Problem 9.3
% Givens
E_R0 = 0.1; % [W/m2]
E_S0 = 0.9; % [W/m2]
k_S = 8.1; % [rad/um]
k_R = 8.3; % [rad/um]
l_R = 1000000; % [um] Reference arm length (1m)
Delta_l = linspace(-1,1, 1000); % [um]
l_S = l_R + Delta_l; % [um] Sample arm length

I = E_R0^2 + E_S0^2 + 2*E_S0*E_R0*cos(2*k_S*l_S - 2*k_R*l_R);

plot(Delta_l, I) %[output:7cbb3438]
xlabel("\Delta L [um]") %[output:7cbb3438]
ylabel("Intensity [W/m2]") %[output:7cbb3438]
title("Single frequency fringe") %[output:7cbb3438]

I_avg = E_R0^2 + E_S0^2;
max_contrast = 2*E_S0*E_R0 / I_avg %[output:0d0cb778]
%%
%[text] Problem 9.7
% Constants
modulation = 0.05;
I_DC = 1;
I_AC = modulation * I_DC;
num_measurements = 1000;
num_freq = 1000;

lambda_0 = 830; % [nm] Center wavelength

bandwidth = [100,50,25]; % [nm]
backscatterer_separation = [4, 2, 1, 0.5]; % [Multiples of l_c]

tl = tiledlayout(numel(bandwidth), numel(backscatterer_separation)); %[output:7bd69afd]

for Delta_lambda = bandwidth %[output:group:40b6ddc5]

    l_c = 4*log(2)/pi*lambda_0^2/Delta_lambda % [nm] Coherence length %[output:07ad3b39] %[output:2d60254a] %[output:6e0fc97c]

    Delta_l = linspace(-l_c*4, l_c*4, num_measurements);
    l_freq = num_measurements/8*l_c; % [1/nm] Spatial frequency of Delta_l measurements 

    for n = backscatterer_separation

        separation = n*l_c;

        location_front = -n*l_c/2; % [nm] 
        location_back = n*l_c/2; % [nm]

        I_front = 0 * Delta_l;
        I_back = 0 * Delta_l;

        for lambda = linspace(lambda_0-Delta_lambda/2, lambda_0+Delta_lambda/2, 100)

            k = 2*pi/lambda; % [1/nm]

            I_front = I_front + I_AC/2/num_measurements*cos(2*k*(Delta_l - location_front));
            I_back = I_back + I_AC/2/num_measurements*cos(2*k*(Delta_l - location_back));

        end

        I = I_front + I_back + I_DC; % Raw interferogram
        
        I_rect = abs(I - mean(I)); % Rectify

        I_fft = fft(I_rect, num_freq); % Lowpass filter
        I_fft(50:num_freq-50) = 0;
        I_low = real(ifft(I_fft, num_measurements));

        nexttile %[output:7bd69afd]
        plot(Delta_l/l_c, I_low*1e3)
        title(sprintf("%gl_c, \\Delta\\lambda=%g nm", n, Delta_lambda))

    end

end %[output:group:40b6ddc5]

title(tl, "TD-OCT Signals varying Bandwidth and Scatterer Separation") %[output:7bd69afd]
xlabel(tl, "\Delta l / l_c") %[output:7bd69afd]
ylabel(tl, "Signal (\times 10^3)") %[output:7bd69afd]

